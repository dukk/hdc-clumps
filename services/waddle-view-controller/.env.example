# Copy to clumps/services/waddle-view-controller/.env in hdc-private (or hdc root; never commit).
# Values are optional unless the package manifest declares env_required.

# Waddle View controller (`clumps/services/waddle-view-controller`) — BFF session signing secret.
# Required when waddle_view_controller.auth_enabled is true (default).
# hdc secrets set HDC_WADDLE_VIEW_CONTROLLER_SESSION_SECRET
# HDC_WADDLE_VIEW_CONTROLLER_SESSION_SECRET=
