{
  "schema_version": 2,
  "defaults": {
    "mode": "proxmox-lxc",
    "proxmox": {
      "lxc": {
        "ostemplate": "local:vztmpl/ubuntu-22.04-standard_22.04-1_amd64.tar.zst",
        "storage": "local-lvm",
        "rootfs_gb": 16,
        "memory_mb": 1024,
        "cores": 1,
        "bridge": "vmbr0",
        "ip_config": "dhcp",
        "unprivileged": 0,
        "features": "nesting=1,keyctl=1",
        "onboot": 1
      }
    },
    "waddle_view_controller": {
      "image": "ghcr.io/dukk/waddle-view-controller",
      "image_tag": "latest",
      "host_port": 8443,
      "public_url": null,
      "auth_enabled": true,
      "session_secret_vault_key": "HDC_WADDLE_VIEW_CONTROLLER_SESSION_SECRET",
      "client_identifier": null
    },
    "install": {
      "enabled": true,
      "compose_dir": "/opt/waddle-view-controller"
    }
  },
  "deployments": [
    {
      "system_id": "waddle-view-controller-a",
      "proxmox": {
        "host_id": "REPLACE_PVE_NODE",
        "lxc": {
          "vmid": 0,
          "hostname": "waddle-view-controller-a"
        }
      }
    }
  ]
}
