{
  "schema_version": 1,
  "freepbx": {
    "admin_user": "admin",
    "admin_password_vault_key": "HDC_FREEPBX_ADMIN_PASSWORD",
    "debian_password_vault_key": "HDC_FREEPBX_DEBIAN_PASSWORD",
    "install_script_url": "https://github.com/FreePBX/sng_freepbx_debian_install/raw/master/sng_freepbx_debian_install.sh",
    "image": {
      "url": "https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2"
    },
    "template_name": "debian-12-freepbx-template",
    "sip_port": 5060,
    "rtp_port_min": 10000,
    "rtp_port_max": 12499,
    "nat": {
      "local_net": "192.0.2.0/24",
      "external_address": "203.0.113.254"
    },
    "twilio": {
      "enabled": true,
      "trunk_name": "twilio0",
      "route_name": "twilio-out",
      "termination_domain": "mytrunk.pstn.example.invalid",
      "outbound_proxy": "pstn.ashburn.twilio.com",
      "credential_username_vault_key": "HDC_TWILIO_SIP_USERNAME",
      "credential_password_vault_key": "HDC_TWILIO_SIP_PASSWORD",
      "identify_cidrs": [
        "54.172.60.0/23",
        "54.244.51.0/24",
        "54.171.127.192/26",
        "35.156.191.128/25",
        "35.171.247.128/25"
      ],
      "dial_prefix": "9"
    }
  },
  "defaults": {
    "mode": "proxmox-qemu",
    "proxmox": {
      "network": {
        "bridge": "vmbr0",
        "gateway": "192.0.2.1"
      },
      "qemu": {
        "template_vmid": 9096,
        "storage": "local-lvm",
        "image_storage": "local",
        "cores": 2,
        "memory_mb": 4096,
        "rootfs_gb": 64
      }
    }
  },
  "deployments": [
    {
      "system_id": "vm-freepbx-a",
      "hostname": "freepbx-a",
      "proxmox": {
        "host_id": "REPLACE_PVE_NODE",
        "qemu": {
          "vmid": 496,
          "ip": "192.0.2.66/24"
        }
      },
      "configure": {
        "ssh": {
          "user": "debian",
          "host": "192.0.2.66"
        }
      }
    }
  ]
}
