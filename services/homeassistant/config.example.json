{
  "schema_version": 3,
  "homeassistant": {
    "release": "16.0",
    "public_url": "https://ha.example.invalid",
    "api": {
      "token_vault_key": "HDC_HOMEASSISTANT_TOKEN"
    },
    "apprise": {
      "enabled": true,
      "name": "apprise",
      "config_url": "http://apprise-a.home.example.invalid:8000/get/ha"
    }
  },
  "automations": [
    {
      "id": "example_porch_light",
      "entity_id": "automation.example_porch_light",
      "managed": true,
      "config": {
        "id": "example_porch_light",
        "alias": "Example porch light (sun)",
        "description": "Fictional example — on at sunset, off at sunrise (see automations/example-porch-light.json for split-layout form)",
        "mode": "single",
        "triggers": [
          { "trigger": "sun", "event": "sunset", "id": "sunset" },
          { "trigger": "sun", "event": "sunrise", "id": "sunrise" }
        ],
        "actions": [
          {
            "choose": [
              {
                "conditions": [{ "condition": "trigger", "id": "sunset" }],
                "sequence": [
                  {
                    "action": "switch.turn_on",
                    "target": { "entity_id": "switch.example_porch_light" }
                  }
                ]
              },
              {
                "conditions": [{ "condition": "trigger", "id": "sunrise" }],
                "sequence": [
                  {
                    "action": "switch.turn_off",
                    "target": { "entity_id": "switch.example_porch_light" }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "defaults": {
    "mode": "proxmox-qemu-haos",
    "proxmox": {
      "qemu": {
        "storage": "local-lvm",
        "image_storage": "local",
        "cores": 2,
        "memory_mb": 4096,
        "rootfs_gb": 32,
        "bridge": "vmbr0"
      },
      "network": {
        "gateway": "192.0.2.1",
        "dns": ["192.0.2.2"]
      }
    }
  },
  "deployments": [
    {
      "system_id": "vm-homeassistant-a",
      "hostname": "ha",
      "homeassistant": {
        "release": "16.0",
        "public_url": "https://ha.example.invalid"
      },
      "proxmox": {
        "host_id": "hypervisor-h",
        "qemu": {
          "vmid": 120,
          "name": "ha",
          "ip": "192.0.2.30/24",
          "usb": []
        }
      }
    }
  ]
}
