{
  "id": "searxng",
  "title": "SearXNG metasearch",
  "env_required": [
    "HDC_SEARXNG_SECRET"
  ],
  "inventory_docs": [
    "operations/inventory/systems/searxng-a.json",
    "operations/inventory/services/searxng.json"
  ],
  "operation_report": {
